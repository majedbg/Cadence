{
  "manifest_version": 3,
  "name": "Cadence Reader",
  "version": "0.1.0",
  "description": "Read selected text on any page as an RSVP overlay, with the active word subtly highlighted in the DOM.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["viewer/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Cadence Reader",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-rsvp": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start RSVP on the current text selection"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Play / pause RSVP"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
